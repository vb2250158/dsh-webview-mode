{
  "manifest_version": 3,
  "name": "DSH WebView Mode",
  "version": "0.2.2",
  "description": "Read and operate the actual iframe pages embedded in your configured DSH conversations.",
  "permissions": ["storage", "webNavigation"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "options_page": "options.html",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "bridge.js"
      ]
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "frame-links.js",
        "frame-dom.js",
        "frame-agent.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
