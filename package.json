{
  "name": "dsh-webview-mode",
  "version": "0.2.8",
  "type": "module",
  "description": "Per-conversation browser side panel for DSH",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.1.0-rc.8",
    "@deepseek-ai/schemastery": "3.18.1",
    "zod": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.1.0-rc.8"
  },
  "license": "MIT",
  "author": "vb2250158",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-webview-mode.git"
  },
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-webview-mode/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "extension"
  ]
}
