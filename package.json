{
  "name": "dsh-webview-mode",
  "version": "0.3.4",
  "type": "module",
  "description": "Agent bridge for the official DSH Sidebar Browser",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./typert": "./lib/typert.host.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-session",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-sidebar-browser"
      ]
    }
  },
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-alpha.1",
    "zod": "^4.0.0",
    "@deepseek-ai/dsh-tools": "0.2.1-alpha.1"
  },
  "license": "MIT",
  "author": "vb2250158",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vb2250158/dsh-webview-mode.git"
  },
  "bugs": {
    "url": "https://github.com/vb2250158/dsh-webview-mode/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "extension",
    "docs",
    "locale",
    "icon.svg",
    "ICON_LICENSE.txt",
    "patches"
  ],
  "peerDependencies": {
    "@deepseek-ai/schemastery": ">=3.18.5-alpha.1 <4.0.0",
    "@deepseek-ai/dsh-api-remotes": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-api-session-controller": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-renderer": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-session": ">=0.2.1-alpha.1 <0.3.0",
    "@deepseek-ai/dsh-client-ui-plugin-manager": ">=0.2.1-alpha.1 <0.3.0"
  },
  "icon": "./icon.svg"
}
